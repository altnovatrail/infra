# What OpenTofu writes beside the configuration and must not be committed: the providers it
# downloads, state, plans and its crash log. The lock file, .terraform.lock.hcl, is committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log

# The packages npm ci installs from tools/package-lock.json, for the checks of the deployment's list.
tools/node_modules/

# The credentials file google-github-actions/auth writes into the checkout in the deployment's jobs.
gha-creds-*.json

# The organizer's upload pages, which tools/organizer/organizer.mjs writes where it runs: whoever
# holds one may upload by it until it expires (R28).
upload-*.html
