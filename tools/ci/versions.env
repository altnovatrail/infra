# The tools of the deployment's jobs that the toolchain stage of .devcontainer/Dockerfile does not
# hold, each at an exact version with its sha256 per architecture, read by tools/ci/install.sh
# (R18). OpenTofu, just and Node it takes from the ARGs of the Dockerfile itself, so that the
# deployment applies and runs the recipes with what the container checks them with. Raised by hand,
# a version together with its sums, as an ARG of the Dockerfile is: Dependabot does not see this file.
#
# The Google Cloud CLI: the versioned archive. Google lists a sha256 only for the archive with no
# version in its name, which moves with every release, so the sums here are the archives' own,
# taken when the version was written down (2026-11-09) from two downloads that agreed.
GCLOUD_VERSION=592.0.0
GCLOUD_SHA256_AMD64=2d841a23a681ab94486af6841e5f1cd123cd300fb8c4be6ba5b51350fca3d50b
GCLOUD_SHA256_ARM64=ba588759c4c42122a8c14536009738c0f0030989ca75788235f9956555e44f4d
# jq: the binary of the release, by its sha256sum.txt.
JQ_VERSION=1.8.2
JQ_SHA256_AMD64=b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f
JQ_SHA256_ARM64=8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309
# buildx, the plugin docker build runs as: the binary of the release, by its checksums.txt. The
# runner's buildx follows each weekly build of the runner's image, so the jobs bring their own.
BUILDX_VERSION=0.38.2
BUILDX_SHA256_AMD64=7992ec09413b80ff57ba4e081f56fc833d7bac1d5e71143c6c809e7e6065f6d6
BUILDX_SHA256_ARM64=46c0f334772de3cb0b341cc415caf7339fb5cfc8b8438ebcb5a10e7f23800d36
# The Docker engine is the runner's, whose image pins it: the jobs build with it only if it is this
# version, and a runner with another stops them, to raise this line on purpose.
DOCKER_ENGINE_VERSION=28.0.4
